// Licensed under the GNU General Public License v3, like the rest of DRAM2.
// Derived from DRAM2's nextflow.config (https://github.com/WrightonLabCSU/DRAM)
// and modified by Rubén Castañeda-Martínez between 2026-01-13 and 2026-10-08
// for the archaeal MAGs of https://github.com/ruben1294/gom-archaeal-mags.
//
// Configuration for step 10 of gom-archaeal-mags, passed to this pipeline with
// -c on top of nextflow.config. Nextflow options take a single dash, DRAM2
// options take a double dash.
//
// Paths and cluster settings are read from the environment, so this file
// carries nothing tied to one machine. scripts/pipeline/10_MAG_distill_DRAM2.sh
// in gom-archaeal-mags exports all of them from its configs/server.env; to
// launch by hand, set at least:
//
//   export REPO_ROOT=/path/to/gom-archaeal-mags
//   export RESULTS_DIR=/path/to/results       # defaults to $REPO_ROOT/results
//   export DRAM2_DB_DIR=/path/to/DRAM_v2_databases
//
// DRAM2_USE_SLURM, DRAM2_PARTITION and DRAM2_NODELIST control the SLURM
// executor, through conf/gom_archaea_slurm.config.
REPO_ROOT = System.getenv('REPO_ROOT')
RESULTS_DIR = System.getenv('RESULTS_DIR') ?: (REPO_ROOT ? "${REPO_ROOT}/results" : null)
DB_DIR = System.getenv('DRAM2_DB_DIR')

if (!RESULTS_DIR) {
    throw new IllegalArgumentException(
        "Set RESULTS_DIR, or REPO_ROOT to the gom-archaeal-mags clone, before running this config.")
}
if (!DB_DIR) {
    throw new IllegalArgumentException(
        "Set DRAM2_DB_DIR to the DRAM2 reference database directory.")
}

includeConfig "${projectDir}/conf/constants.config"

// Global default params, used in configs
params {



    // Nextflow runs offline here, so no remote institutional profiles are fetched.
    custom_config_base = null
    custom_config_version = null

    /* Pipeline Steps */
    // summarize and visualize both switch on traits, and all three need the
    // KEGG database below (use_kegg). KEGG is licensed: see "KEGG licensing" in
    // the README of gom-archaeal-mags before enabling it. Without a licensed copy, set use_kegg to
    // false and the three steps run on the remaining databases.
    rename                     = true
    annotate                   = true
    summarize                  = true // 2026/02/17: Trying now that we have a KEGG DB version.
    visualize                  = true // 2026/02/17: Trying now that we have a KEGG DB version.
    traits                     = true // 2026/02/22: Re-enabled. Updated rules.tsv to new Lark/Polars format (traits_rules.tsv from DRAM2 825521de).
    qc                         = true
    sum_ecos                   = ""
    sum_custom                 = ""

    call                       = true

    merge_annotations          = null  // Directory containing .tsv files to merge_annotations
    format_kegg                = false // 2026/02/22: Didn't worked. Also, we did MMseqs2 outside of DRAM2 to KEGG DB.

    /* Genome options */
    input_fasta                = "${RESULTS_DIR}/01_mag_quality/filtered"
    fasta_fmt                  = '*.fa'
    //input_genes                = "$GENES_DIR"
    //genes_fmt                  = '*.faa'
//    genes_fna_fmt              = '*.fna'

    /* Call Prodigal Options */
    prodigal_mode = 'single'
    prodigal_trans_table = 11
    // 2,500 is strict for fragmented archaeal MAGs; 1,000 is the better default.
    //min_contig_len = 2500
    min_contig_len = 1000

    /* Annotate Options */
    // Annotation Database Flags
    use_dram_db = false
    use_kegg = true
    use_kofam = true
    use_dbcan = true
    use_camper = true
    use_fegenie = true
    use_methyl = true
    use_canthyd = false
    // use_heme = false
    use_sulfur = true
    use_pfam = false // Disabled: a bug in this DRAM2 release breaks the Pfam step.
    use_merops = false
    use_uniref = true // 20260125: Downloaded archaea&unclassified-only Uniref. Will try annotation with it.
    use_metals = true
    use_vog = false  // TODO: Add vog annotation, not well supported currently
    use_viral = false // TODO: Add viral annotation, not well supported currently
    // use_viral = false  // TODO: Add viral annotation

    // These options arrived in a later DRAM2 release. A rename meant the merge
    // did not pick them up on the first attempt.
    use_antismash = false
    use_tcdb = false
    use_rgi = false
    use_card = false


    // Alternative way to specify databases, comma-separated list
    anno_dbs = ""

    add_annotations = null
    bit_score_threshold =  60 // MMseqs threshold search to retain hits.
    rbh_bit_score_threshold =  350 // Reverse Best Hits MMseqs threshold search to retain hits.

    /* Taxonomy and Bin Quality ingest */
    // Path to the GTDB-Tk summary.tsv, to carry taxonomy into the distillate:
    taxa = "${RESULTS_DIR}/03_taxonomy_assigned/classify/tax_.ar53.summary.tsv"
    // Path to the CheckM2 quality_report.tsv, to carry completeness and
    // contamination into the distillate:
    bin_quality = "${RESULTS_DIR}/01_mag_quality/quality_report.tsv"

    /* Database list for generating GFF and GBK */
    database_list = "all"
    generate_gff = false
    generate_gbk = false

    // Distill options
    annotations = null
    // The distill sheets below cannot be combined with --annotate: DRAM2 rejects
    // --annotations alongside it, since that path is for running distill over
    // annotations produced by an earlier run.
    //annotations = [
//        "${projectDir}/bin/assets/forms/distill_sheets/distill_carbon.tsv",
//       "${projectDir}/bin/assets/forms/distill_sheets/distill_energy.tsv",
//        "${projectDir}/bin/assets/forms/distill_sheets/distill_nitrogen.tsv"
//    ]
    // RNA Sheets
    rrnas = null
    trnas = null

    /* E-value cutoffs for each database */
    kegg_e_value = "1e-5"
    kofam_e_value = "1e-5"
    dbcan_e_value = "1e-15"
    merops_e_value = "1e-1"
    vog_e_value = "1e-5"
    camper_e_value = "1e-5"
    uniref_e_value = "1e-5"
    canthyd_e_value = "1e-5"
    sulfur_e_value = "1e-5"
    fegenie_e_value = "1e-5"
    metals_e_value = "1e-3"

    // Database locations
    // DRAM DB
    dram_db = "${DB_DIR}/dram_db/dram_db.hmm"
    dram_db_list = "${DB_DIR}/dram_db/dram_db_scores.tsv"
    // KEGG
    kegg_db = "${DB_DIR}/kegg_2018/"
    //kegg_db = "/path/to/kegg_2018/"
    // Uniref
    // 20260125: Will try with archaea&unclassified-only Uniref.
    //uniref_db = "${DB_DIR}/uniref/"
    uniref_db = "${DB_DIR}/uniref_archaea/"
    // Pfam
    pfam_mmseq_db = "${DB_DIR}/pfam/mmseqs/"
    // merops
    merops_db = "${launchDir}/databases/merops/"
    // viral
    viral_db = "${launchDir}/databases/viral/"
    // kofam
    kofam_db = "${DB_DIR}/kofam/"
    kofam_list = "${DB_DIR}/kofam/kofam_ko_list.tsv"
    // dbcan
    dbcan_db = "${DB_DIR}/dbcan/"
    dbcan_fam_activities = "${DB_DIR}/dbcan/dbcan.fam-activities.tsv"
    // Upstream nextflow.config points this at fam_activities, the same file as
    // the entry above. The correct filename is the one below.
    dbcan_subfam_activities = "${DB_DIR}/dbcan/dbcan.fam.subfam.ec.tsv"
    // vogdb
    vog_db = "${launchDir}/databases/vogdb/"
    vog_list = "${launchDir}/databases/vogdb/vog_annotations_latest.tsv.gz"
    // CAMPER
    camper_hmm_db = "${DB_DIR}/camper/hmm/"
    camper_hmm_list = "${DB_DIR}/camper/hmm/camper_hmm_scores.tsv"
    camper_mmseqs_db = "${DB_DIR}/camper/mmseqs/"
    camper_mmseqs_list = "${DB_DIR}/camper/mmseqs/camper_scores.tsv"
    // cant hyd
    canthyd_hmm_db = "${launchDir}/databases/canthyd/hmm/"
    cant_hyd_hmm_list = "${launchDir}/databases/canthyd/hmm/cant_hyd_HMM_scores.tsv"
    canthyd_mmseqs_db = "${launchDir}/databases/canthyd/mmseqs/"
    canthyd_mmseqs_list = "${launchDir}/databases/canthyd/mmseqs/cant_hyd_BLAST_scores.tsv"
    // fegenie
    fegenie_db = "${DB_DIR}/fegenie/"
    fegenie_list = "${DB_DIR}/fegenie/fegenie_iron_cut_offs.txt"
    // Sulfur
    sulfur_db = "${DB_DIR}/sulfur/"
    // Methyl
    methyl_db = "${DB_DIR}/methyl/"
    // Metals
    metals_db = "${DB_DIR}/metals/"
    // antiSMASH
    antismash_db = "${DB_DIR}/antismash/"
    // rgi card
    card_db = "${DB_DIR}/card/"
    // TCDB
    tcdb_db = "${DB_DIR}/tcdb/"
    // SQL annotation descriptions database
    sql_descriptions_db = "${DB_DIR}/db_descriptions/description_db.sqlite"
    /* Product options */
    groupby_column = params.CONSTANTS.FASTA_COLUMN

    /* Adjectives Options */
    adjectives_list = ""
    //adjectives_list = null
    // The archaea-calibrated rule set, not the DRAM2 default. It recalibrates
    // the trait calls that a bacteria-derived rule set gets wrong on archaea,
    // among them the mcr signature, the amoA and pmoA ambiguity that makes AOA
    // look methanotrophic, and the ETC50 threshold that misreads respiratory
    // archaea as fermenters. See the notes column of the file itself.
    //
    // It is read from this repository rather than from the DRAM2 checkout
    // because Docker will not follow a symlink out of the mounted tree. Upstream
    // renamed this parameter from rules_tsv to trait_rules_tsv.
    trait_rules_tsv = "${projectDir}/bin/assets/traits_rules_archaea.tsv"

    /* Format KEGG options */
    // 2026/02/18: Added options to see if the work.
    kegg_pep_root_dir = null
    kegg_pep_loc = null
    gene_ko_link_loc = null
    kegg_download_date = null
    skip_gene_ko_link = false


    //kegg_pep_root_dir = null
    //kegg_pep_loc = "${DB_DIR}/kegg_reduced_2018/kegg.reduced.fasta"
    //gene_ko_link_loc = null
    //kegg_download_date = "2018-12-30"
    //skip_gene_ko_link = true

    /* SLURM options */
    // From configs/server.env. An empty partition or node list leaves the
    // choice to the scheduler.
    slurm = (System.getenv('DRAM2_USE_SLURM') ?: 'true').toBoolean()
    partition = System.getenv('DRAM2_PARTITION') ?: null
    slurm_node = System.getenv('DRAM2_NODELIST') ?: null

    // Slurm resource requirements
    // These are the default values for the slurm profile
    // If not defined, will default to the largest Process resource requirements
    cpu_provision_limit = 24
    mem_gb_provision_limit = 120 // Leaves headroom on a 128 GB node
    time_hr_provision_limit = 140
    

    /* Process Options */
    queue_size = 2 // Concurrent tasks. Available RAM is split between them, so
               // raise it only if the modules in play are light. 3 worked here.
    // This is the resource requirements for a single process
    // Not the limit to the total resources available to the pipeline
    // Up to queue_size processes can run in parallel, of various sizes
    tiny_cpus_limit = 1
    small_cpus_limit = 2
    medium_cpus_limit = 6
    big_cpus_limit = 12
    huge_cpus_limit = 24

    tiny_gb_mem_limit = 1
    small_gb_mem_limit = 12
    medium_gb_mem_limit = 36
    big_gb_mem_limit = 72
    huge_gb_mem_limit = 120

    tiny_hr_time_limit = 1
    small_hr_time_limit = 4
    medium_hr_time_limit = 8
    big_hr_time_limit = 16
    huge_hr_time_limit = 140  // For very large genomes, you may need to increase this


    /* Deprecated options */
    distill_topic              = ""
    distill_ecosystem          = ""
    product                    = false
    adjectives                 = false
    distill_custom             = ""


    /* MultiQC options */
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    /* Boilerplate options */
    outdir                       = null
    threads                      = 24 // CPUs per node
    // Dummy sheet
    distill_dummy_sheet          = "${projectDir}/bin/assets/forms/distill_sheets/dummy.tsv"

    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    help                         = false
    // help_full                    = false
    // show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')// Config options
    config_profile_name        = null
    config_profile_description = null

    // Commented out: this fails under NXF_OFFLINE.
    //custom_config_version      = 'master'
    //custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}


includeConfig "${projectDir}/conf/base.config"

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = true
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = false
        conda.useMamba          = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        // 2026/01/24: This is the form that works. The one below has no effect.
        docker.runOptions       = '-u $(id -u):$(id -g)'
        //docker.runOptions       = '-u $(id -u):$(id -g) --cpus=24 --memory=120g'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = false
        singularity.autoMounts  = false
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = false
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = false
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = false
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = false
        apptainer.autoMounts    = false
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = false
        singularity.ociAutoPull = false
        wave.enabled            = false
        wave.freeze             = false
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }
    // gpu {
    //     docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
    //     apptainer.runOptions    = '--nv'
    //     singularity.runOptions  = '--nv'
    // }
    test       { includeConfig "${projectDir}/conf/test.config"      }
    test_skips { includeConfig "${projectDir}/conf/test_skips.config" }
    // (WARNING, this profile name may change in the future)
    full_mode {
        params.annotate   = true
        params.summarize  = true
        params.visualize  = true
        params.traits     = true
        params.qc         = true
        params.anno_dbs  = 'all'
    }
}

// The SLURM executor settings live in this repository, not in the DRAM2
// checkout, so a fresh pull of the pinned commit needs nothing copied into it.
includeConfig params.slurm ? "${projectDir}/conf/gom_archaea_slurm.config" : "/dev/null"

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load WrightonLabCSU/dram custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load WrightonLabCSU/dram custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/dram.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

// The DRAM2 manifest, copied verbatim from the pipeline's nextflow.config at
// the pinned commit. The validation block below reads it, and a -c config is
// parsed on its own, so the block has to be repeated here unchanged.
manifest {
    name            = 'WrightonLabCSU/dram'
    author          = """Rory M Flynn, Kelly C. Wrighton, Mikayla Borton, Reed Woyda, Madeline Scyphers""" // The author field is deprecated from Nextflow version 24.10.0, use contributors instead
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Rory M Flynn',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Kelly C. Wrighton',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Mikayla Borton',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Reed Woyda',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: ' Madeline Scyphers',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/WrightonLabCSU/dram'
    description     = """DRAM (Distilled and Refined Annotation of Metabolism) is a tool for annotating metagenomic assembled genomes"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24'
    version         = '2.0.0-beta28'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.1.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
    id 'nf-validation@1.1.4' // Pinned because NXF_OFFLINE cannot resolve a version
                         // at run time. The plugin is legacy, renamed to
                         // nf-schema upstream, but DRAM2 still asks for the old
                         // name. 1.1.4 is what the offline cache holds.
}

boost {
    cleanup = false
}

validation {
    defaultIgnoreParams = ["CONSTANTS"]
    monochromeLogs = params.monochrome_logs
    help {
        enabled = true
        command = "nextflow run WrightonLabCSU/dram -profile <docker/singularity/.../institute/full_mode> --input_fasta path/to/input_fasta <pipeline steps and options, --call, --annotate, etc.> --outdir path/to/outdir"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
        beforeText = """
\033[2m=====================================================================                     \033[0m
                                                                                                 \033[0m
\033[0;34m                 _____    _____               __  __                                    \033[0m
\033[0;32m(==(     )==)\033[0;34m   |  __ \\  |  __ \\      /\\     |  \\/  |   \033[0;32m(==(     )==)     \033[0m
\033[0;32m `-.`. ,',-'\033[0;34m    | |  | | | |__) |    /  \\    | \\  / |    \033[0;32m`-.`. ,',-'         \033[0m
\033[0;32m    _,-'"\033[0;34m       | |  | | |  _  /    / /\\ \\   | |\\/| |       \033[0;32m_,-'"            \033[0m
\033[0;32m ,-',' `.`-.\033[0;34m    | |__| | | | \\ \\   / ____ \\  | |  | |    \033[0;32m,-',' `.`-.         \033[0m
\033[0;32m(==(     )==)\033[0;34m   |_____/  |_|  \\_\\ /_/    \\_\\ |_|  |_|   \033[0;32m(==(     )==)       \033[0m
                                        
\033[0;35m  ${manifest.name} ${manifest.version}\033[0m
\033[2m=====================================================================\033[0m

In addition to the parameters below, there are many Nextflow specific parameters that you may find useful, such as `-profile` to select a configuration profile, `-resume` to restart from a previous run, and `-c` to specify a custom config file.
See `nextflow run -help` for more information, or https://nextflow.io/docs/latest/config.html and https://nextflow.io/docs/latest/cache-and-resume.html for good places to start looking.
Also see the DRAM nextflow.config file and documentation for a full list of all profiles, which include dependency management options (e.g. conda, docker, singularity, etc.), as well as run modes (full_mode, etc.)
"""
        afterText = """${manifest.doi ? "* The pipeline\n" : ""}${manifest.doi.tokenize(",").collect { "  https://doi.org/${it.trim().replace('https://doi.org/','')}"}.join("\n")}${manifest.doi ? "\n" : ""}
* Software dependencies
    https://github.com/${manifest.name}/blob/master/CITATIONS.md
"""
    }
    summary {
        beforeText = validation.help.beforeText
        afterText = validation.help.afterText
    }
}

// Load modules.config for DSL2 module specific options
includeConfig "${projectDir}/conf/modules.config"
