// Licensed under the GNU General Public License v3, like the rest of DRAM2.
// Derived from DRAM2's nextflow.config (https://github.com/WrightonLabCSU/DRAM)
// and modified by Rubén Castañeda-Martínez between 2026-01-13 and 2026-10-08
// for the archaeal MAGs of https://github.com/ruben1294/gom-archaeal-mags.
//
// SLURM executor settings, included by conf/gom_archaea_mags.config and its test
// variant when params.slurm is true. Adapted from conf/slurm.config. The
// partition and node list arrive as params, which those configs fill from
// DRAM2_PARTITION and DRAM2_NODELIST; left empty, the scheduler picks.
params {
  config_profile_description = 'SLURM executor profile for DRAM2 (gom-archaeal-mags)'
  config_profile_contact = 'Rubén Castañeda-Martínez'
  config_profile_url = 'https://github.com/ruben1294/gom-archaeal-mags'
}

process {
  resourceLimits = [
    cpus: params.cpu_provision_limit ? params.cpu_provision_limit : params.huge_cpus_limit,
    memory: params.mem_gb_provision_limit ? params.mem_gb_provision_limit.GB : params.huge_gb_mem_limit.GB,
    time: params.time_hr_provision_limit ? params.time_hr_provision_limit.h : params.huge_hr_time_limit.h
  ]
  // Set explicitly so the value reaches MMseqs2, which otherwise used fewer
  // threads than the job was given.
  cpus = 24
  executor = 'slurm'
  queue    = params.partition
  clusterOptions = (params.slurm_node ? "--nodelist=${params.slurm_node} --exclusive" : "")
}

executor {
  queueSize = params.queue_size
}
